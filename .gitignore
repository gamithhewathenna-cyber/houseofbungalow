# =====================================================================
# House of Bungalow - Git ignore rules
#
# Keeps production secrets and database content out of GitHub. GitHub
# should hold application source code only - the live database is
# managed directly in cPanel/phpMyAdmin, never imported/exported through
# this repo.
# =====================================================================

# --- Real config with live DB credentials (tracked: config/config.sample.php) ---
config/config.php

# --- Database schema/seed/migration SQL - copy-pasted into phpMyAdmin by hand,
#     never auto-imported, so there's no reason for these to live on GitHub ---
*.sql

# --- Env/credential files, in case any get added later ---
.env
.env.*
*.pem
*.key
*credentials*
*secret*

# --- Backup/editor/temp files - these aren't routed through the PHP
#     handler, so if one ever lands in a public folder it would serve as
#     plain text instead of executing ---
*.bak
*.backup
*.old
*.orig
*~
*.swp
*.swo

# --- Logs ---
*.log

# --- User-uploaded content (admin-uploaded photos, job-application CVs,
#     etc.) - lives only on the live server, not in source control ---
/uploads/*
!/uploads/.htaccess

# --- OS/editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
